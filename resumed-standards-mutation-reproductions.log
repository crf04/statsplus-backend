"""Temporary review reproductions, removed before handoff. All markers synthetic."""
import json
import pytest

@pytest.mark.parametrize('parameter,value', [
    ('self_filters[token=review-synthetic-marker]', 'bad'),
    ('self_filters[TOKEN=REVIEW-SYNTHETIC-MARKER]', '1,2'),
    ('self_filters[' + 'x' * 600 + ']', 'bad'),
])
def test_review_parameter_boundary(client, parameter, value):
    from app.errors import sanitize_public_value
    response = client.get('/api/games/game_logs', query_string={
        'player_name':'LeBron James', parameter: value,
    })
    assert response.status_code == 400
    detail = response.get_json()['error']['details']['filters'][0]
    print(json.dumps({'request_parameter': parameter, 'value': value, 'response': detail, 'sanitizer_would_produce': sanitize_public_value(detail['parameter'])}))
    if len(parameter) > 200:
        assert len(detail['parameter']) > 200
    else:
        assert 'SYNTHETIC-MARKER' in detail['parameter'].upper()
        assert 'SYNTHETIC-MARKER' not in sanitize_public_value(detail['parameter']).upper()

@pytest.mark.parametrize('parameter,value', [
    ('self_filters[PTS]', '10,0'),
    ('self_filters[BOGUS]', 'a,2'),
    ('minutes_filter', 'a,b'),
])
def test_review_uncovered_rejections(client, parameter, value):
    response = client.get('/api/games/game_logs', query_string={
        'player_name': 'LeBron James', parameter: value,
    })
    assert response.status_code == 400
    print(json.dumps({'request_parameter':parameter,'value':value,'error':response.get_json()['error']}))
