# Database Configuration
# The bundled demo SQLite database is intentionally tracked for local startup.
DATABASE_URL=sqlite:///nba_play_types.db
# Canonical athlete catalogs are refreshed for explicit seasons by the
# operator command; this is the persisted freshness TTL in days.
ATHLETE_CATALOG_FRESHNESS_DAYS=7

# LLM Configuration
# Leave blank to run in deterministic NLP mode without OpenAI fallback.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_TIMEOUT=10.0
LLM_MAX_RETRIES=3
# The typed settings loader automatically disables this when OPENAI_API_KEY is blank.
ENABLE_LLM_FALLBACK=True
LLM_CONFIDENCE_THRESHOLD=0.7

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379
ENABLE_CACHE=true
REDISHOST=localhost
REDISPORT=6379
REDISDB=0
REDISPASSWORD=
REDISTLS=false

# Firebase Admin SDK Configuration
# Do not commit Firebase service-account JSON, private keys, or real client emails.
# Protected routes fail closed when Firebase Admin cannot initialize. For local,
# credential-free development only, you may set FIREBASE_ADMIN_DISABLED=true to
# use the synthetic dev-user. This bypass requires FLASK_ENV=development or a
# test app and is rejected in production; never enable it in a deployment.
FIREBASE_ADMIN_DISABLED=false
#
# Option 1: Local service-account JSON file path.
# Keep the file outside the repo or in a gitignored path.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option 2: Service Account JSON as environment variable (for deployment)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 3: Individual Firebase credentials (alternative for deployment)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# NBA API HTTP Configuration
# stats.nba.com requests made through the nba_api package.
NBA_STATS_TIMEOUT_SECONDS=10
# Max concurrent stats.nba.com calls in the game-log request path.
NBA_STATS_MAX_CONCURRENCY=10
# Maximum age of a successful canonical event catalog, in hours.
EVENT_CATALOG_MAX_AGE_HOURS=72

# PBP Stats requests made through the shared requests session.
NBA_API_TIMEOUT_CONNECT=10
NBA_API_TIMEOUT_READ=30
NBA_API_MAX_RETRIES=3
NBA_API_POOL_CONNECTIONS=10
NBA_API_POOL_MAXSIZE=20

# DFS Board. The authenticated GET /api/dfs/board route is published only when
# both DFS_BOARD_ENABLED is true and DFS_ENABLED_PROVIDERS names at least one
# provider; startup refuses the flag without a registry. Both halves are off by
# default here, so a fresh checkout exposes no board and calls no provider.
DFS_BOARD_ENABLED=false
# DFS is disabled when the provider list is omitted. Production must set a
# non-empty explicit list; local/test runs may opt in explicitly.
# DFS_ENABLED_PROVIDERS=dabble,prizepicks,underdog
DFS_BOARD_DEADLINE_SECONDS=15
DFS_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
DFS_PROVIDER_READ_TIMEOUT_SECONDS=8
DFS_DABBLE_DETAIL_CONCURRENCY=3
# Normalized ProviderSnapshot cache windows are maximum ages. The scalar
# defaults apply to every provider; use DFS_<PROVIDER>_* to override one.
DFS_CACHE_FRESH_SECONDS=300
DFS_CACHE_STALE_IF_ERROR_SECONDS=1800
# DFS_DABBLE_CACHE_FRESH_SECONDS=300
# DFS_DABBLE_CACHE_STALE_IF_ERROR_SECONDS=1800

# Browser access configuration
# Local development explicitly allows the usual frontend dev server. For a
# deployment, replace this with a comma-separated exact origin allowlist; do
# not use '*' or include paths. Production startup requires this to be set.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# App Configuration
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO
