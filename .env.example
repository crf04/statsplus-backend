# Database Configuration
# The bundled demo SQLite database is intentionally tracked for local startup.
DATABASE_URL=sqlite:///nba_play_types.db
# Canonical athlete catalogs are refreshed for explicit seasons by the
# operator command; this is the persisted freshness TTL in days.
ATHLETE_CATALOG_FRESHNESS_DAYS=7

# LLM Configuration
# Leave blank to run in deterministic NLP mode without OpenAI fallback.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_TIMEOUT=8.0
# Query parsing falls back immediately to the deterministic result after one failed attempt.
LLM_MAX_RETRIES=1
# The typed settings loader automatically disables this when OPENAI_API_KEY is blank.
ENABLE_LLM_FALLBACK=True
LLM_CONFIDENCE_THRESHOLD=0.7

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379
ENABLE_CACHE=true
REDISHOST=localhost
REDISPORT=6379
REDISDB=0
REDISPASSWORD=
REDISTLS=false

# Firebase Admin SDK Configuration
# Do not commit Firebase service-account JSON, private keys, or real client emails.
# Protected routes fail closed when Firebase Admin cannot initialize. For local,
# credential-free development only, you may set FIREBASE_ADMIN_DISABLED=true to
# use the synthetic dev-user. This bypass requires FLASK_ENV=development or a
# test app and is rejected in production; never enable it in a deployment.
FIREBASE_ADMIN_DISABLED=false
#
# Option 1: Local service-account JSON file path.
# Keep the file outside the repo or in a gitignored path.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option 2: Service Account JSON as environment variable (for deployment)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 3: Individual Firebase credentials (alternative for deployment)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# HMAC key for short-lived Collector tokens; deployment secret, never commit.
COLLECTOR_SIGNING_SECRET=

# Standalone Residential Collector (used by python -m app.collector). The
# machine secret is never an environment value in production; install it in
# Windows Credential Manager under StatsPlus/Collector/<identity>.
COLLECTOR_RAILWAY_URL=https://railway.example.invalid
COLLECTOR_ENVIRONMENT=historical_rehearsal
COLLECTOR_IDENTITY_ID=
COLLECTOR_OUTBOX_PATH=
COLLECTOR_LOG_PATH=
COLLECTOR_RELEASE_VERSION=0.1.0
COLLECTOR_TOKEN_TTL_SECONDS=300
COLLECTOR_POLL_LIMIT=100
COLLECTOR_HTTP_TIMEOUT_SECONDS=30
COLLECTOR_OUTBOX_MAX_BYTES=268435456
COLLECTOR_OUTBOX_MAX_ITEM_BYTES=2097152
COLLECTOR_RETRY_WINDOW_SECONDS=21600
COLLECTOR_RETRY_INTERVAL_SECONDS=1800
COLLECTOR_ALLOW_INSECURE_LOCALHOST=false

# NBA API HTTP Configuration
# stats.nba.com requests made through the nba_api package.
NBA_STATS_TIMEOUT_SECONDS=10
# Max concurrent stats.nba.com calls in the game-log request path.
NBA_STATS_MAX_CONCURRENCY=10
# Maximum age of a successful canonical event catalog, in hours.
EVENT_CATALOG_MAX_AGE_HOURS=72
# Maximum age shown as fresh on the nightly schedule surface, in hours.
SLATE_SCHEDULE_MAX_AGE_HOURS=30
# Maximum age for serving current-season durable player game logs, in hours.
PLAYER_GAME_LOG_MAX_AGE_HOURS=30
# Minimum positive-minute players required for each team in a completed game.
PLAYER_GAME_LOG_MIN_ACTIVE_PLAYERS_PER_TEAM_GAME=5
# How many past days of completed games the incremental PBP player-log refresh
# re-fetches so upstream stat corrections replace the affected games' rows.
PLAYER_GAME_LOG_RECONCILIATION_DAYS=3
# Minimum delivered rows before each matchup-selection table is not thin.
MATCHUP_SELECTION_H2H_MIN_GAMES=1
MATCHUP_SELECTION_ARCHETYPE_MIN_GAMES=5
# Season player-evidence floors that mark a delivered Matchup Score cell thin.
MATCHUP_SCORE_MIN_GAMES=5
MATCHUP_SCORE_PLAY_TYPES_MIN_VOLUME_PER_GAME=1
MATCHUP_SCORE_SHOT_ZONES_MIN_VOLUME_PER_GAME=1
MATCHUP_SCORE_SHOT_TYPES_MIN_VOLUME_PER_GAME=4
MATCHUP_SCORE_ASSIST_LOCATIONS_MIN_VOLUME_PER_GAME=1

# PBP Stats requests made through the shared requests session.
NBA_API_TIMEOUT_CONNECT=10
NBA_API_TIMEOUT_READ=30
NBA_API_MAX_RETRIES=3
NBA_API_POOL_CONNECTIONS=10
NBA_API_POOL_MAXSIZE=20

# DFS Board. The authenticated GET /api/dfs/board route is published only when
# both DFS_BOARD_ENABLED is true and DFS_ENABLED_PROVIDERS names at least one
# provider; startup refuses the flag without a registry. Both halves are off by
# default here, so a fresh checkout exposes no board and calls no provider.
DFS_BOARD_ENABLED=false
# Expansion gate for database-only projection reads. Leave false until the
# projection archive has been populated and verified.
PROJECTION_ARCHIVE_READ_ENABLED=false
PROJECTION_ARCHIVE_READ_PROVIDER=dabble
# DFS is disabled when the provider list is omitted. Production must set the
# variable explicitly; an explicit empty value disables every provider.
# DFS_ENABLED_PROVIDERS=dabble,prizepicks,underdog
DFS_BOARD_DEADLINE_SECONDS=15
DFS_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
DFS_PROVIDER_READ_TIMEOUT_SECONDS=8
DFS_DABBLE_DETAIL_CONCURRENCY=3
# Independent ceilings: the board limit applies after request filters, while
# the archive limit rejects one normalized provider evidence document before
# persistence.
DFS_COMPARISON_MAX_MARKETS=10000
PROJECTION_ARCHIVE_MAX_MARKETS=10000
# Normalized ProviderSnapshot cache windows are maximum ages. The scalar
# defaults apply to every provider; use DFS_<PROVIDER>_* to override one.
DFS_CACHE_FRESH_SECONDS=300
DFS_CACHE_STALE_IF_ERROR_SECONDS=1800
# DFS_DABBLE_CACHE_FRESH_SECONDS=300
# DFS_DABBLE_CACHE_STALE_IF_ERROR_SECONDS=1800

# Injury Report. Both gates must be true before the RotoWire adapter is even
# constructed. Keep them false until written permission or explicit legal
# approval covers automated collection and display.
INJURY_REPORT_ENABLED=false
ROTOWIRE_PERMISSION_GRANTED=false
ROTOWIRE_CONNECT_TIMEOUT_SECONDS=3
ROTOWIRE_READ_TIMEOUT_SECONDS=8

# Browser access configuration
# Local development explicitly allows the usual frontend dev server. For a
# deployment, replace this with a comma-separated exact origin allowlist; do
# not use '*' or include paths. Production startup requires this to be set.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# App Configuration
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO
