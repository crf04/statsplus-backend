# Redis Configuration (Optional - defaults provided)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
ENABLE_CACHE=true

# LLM Configuration (if using OpenAI features)
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_TIMEOUT=10.0
LLM_MAX_RETRIES=3
ENABLE_LLM_FALLBACK=True
LLM_CONFIDENCE_THRESHOLD=0.7

# Flask Configuration
FLASK_ENV=development
DEBUG=True