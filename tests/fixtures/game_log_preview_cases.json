{
  "description": "Default line and hit count for a game-log link preview, over every game the link's filters match. Mirrored in backend tests and frontend tests; change all three together. `values` are newest first, as GET /api/games/game_logs returns rows. `lines` uses the backend posted_line.lines shape.",
  "cases": [
    {
      "name": "posted line beats the season average; every matching game counts; a push misses",
      "line_type": "PTS",
      "lines": {
        "PTS": {
          "value": 24.5,
          "provider": "prizepicks"
        }
      },
      "season_averages": {
        "PTS": 22.04
      },
      "values": [
        30,
        25,
        24.5,
        20,
        26,
        24,
        28,
        19,
        31,
        22,
        40,
        10
      ],
      "expect": {
        "line": "24.5",
        "source": "posted",
        "provider": "prizepicks",
        "hits": 6,
        "games": 12
      }
    },
    {
      "name": "no posted line falls back to the season average at one decimal",
      "line_type": "REB",
      "lines": {},
      "season_averages": {
        "REB": 8.46
      },
      "values": [
        9,
        8.5,
        8,
        10
      ],
      "expect": {
        "line": "8.5",
        "source": "season_average",
        "provider": null,
        "hits": 2,
        "games": 4
      }
    },
    {
      "name": "an exact half rounds up, as JavaScript toFixed does",
      "line_type": "AST",
      "lines": {},
      "season_averages": {
        "AST": 6.25
      },
      "values": [
        6.3,
        7,
        6
      ],
      "expect": {
        "line": "6.3",
        "source": "season_average",
        "provider": null,
        "hits": 1,
        "games": 3
      }
    },
    {
      "name": "a binary value just under the half rounds down",
      "line_type": "PTS",
      "lines": {},
      "season_averages": {
        "PTS": 18.45
      },
      "values": [
        18.4,
        18.5
      ],
      "expect": {
        "line": "18.4",
        "source": "season_average",
        "provider": null,
        "hits": 1,
        "games": 2
      }
    },
    {
      "name": "FG3M reads the 3PM market",
      "line_type": "FG3M",
      "lines": {
        "3PM": {
          "value": 2.5,
          "provider": "underdog"
        }
      },
      "season_averages": {
        "FG3M": 3.1
      },
      "values": [
        3,
        2,
        4
      ],
      "expect": {
        "line": "2.5",
        "source": "posted",
        "provider": "underdog",
        "hits": 2,
        "games": 3
      }
    },
    {
      "name": "a posted market for another stat is not used",
      "line_type": "REB",
      "lines": {
        "PTS": {
          "value": 24.5,
          "provider": "prizepicks"
        }
      },
      "season_averages": {
        "REB": 7
      },
      "values": [
        8,
        7
      ],
      "expect": {
        "line": "7.0",
        "source": "season_average",
        "provider": null,
        "hits": 1,
        "games": 2
      }
    },
    {
      "name": "no posted line and no season average makes no hit claim",
      "line_type": "STL",
      "lines": {},
      "season_averages": {},
      "values": [
        1,
        0,
        2
      ],
      "expect": {
        "line": null,
        "source": null,
        "provider": null,
        "hits": null,
        "games": 3
      }
    },
    {
      "name": "a link line overrides the posted line",
      "line_type": "PTS",
      "link_line": "26",
      "lines": {
        "PTS": {
          "value": 24.5,
          "provider": "prizepicks"
        }
      },
      "season_averages": {
        "PTS": 22.04
      },
      "values": [
        30,
        25,
        26,
        20,
        27
      ],
      "expect": {
        "line": "26",
        "source": "link",
        "provider": null,
        "hits": 2,
        "games": 5
      }
    },
    {
      "name": "a link line is used as given, not rounded",
      "line_type": "REB",
      "link_line": "8.25",
      "lines": {},
      "season_averages": {
        "REB": 8.46
      },
      "values": [
        9,
        8.25,
        8,
        8.5
      ],
      "expect": {
        "line": "8.25",
        "source": "link",
        "provider": null,
        "hits": 2,
        "games": 4
      }
    }
  ],
  "filter_cases": [
    {
      "query": "player_name=Jalen+Johnson",
      "filters": "Every logged game"
    },
    {
      "query": "player_name=Jalen+Johnson&season_filter=2025-26",
      "filters": "2025-26 season"
    },
    {
      "query": "player_name=Jalen+Johnson&season_filter=2025-26&players_off%5B%5D=Trae+Young",
      "filters": "2025-26 season, without Trae Young"
    },
    {
      "query": "player_name=Jalen+Johnson&game_filter=10&location_filter=Home",
      "filters": "Last 10 games, home games"
    },
    {
      "query": "player_name=Jalen+Johnson&opponent_tricode=BOS&location_filter=Away",
      "filters": "Away games, vs BOS"
    },
    {
      "query": "player_name=Jalen+Johnson&teams_against%5B%5D=OPP_PTS&rank_filter%5B%5D=10&minutes_filter=25%2C48",
      "filters": "Vs top 10 Points Allowed D, 25-48 minutes"
    },
    {
      "query": "player_name=Jalen+Johnson&teams_against%5B%5D=OPP_REB&rank_filter%5B%5D=-5",
      "filters": "Vs bottom 5 Rebounds Allowed D"
    },
    {
      "query": "player_name=Jalen+Johnson&date_filter=2026-01-01&date_to=2026-02-15",
      "filters": "Since 2026-01-01, through 2026-02-15"
    },
    {
      "query": "player_name=Jalen+Johnson&players_on%5B%5D=Trae+Young&players_on%5B%5D=Dyson+Daniels&players_off%5B%5D=Clint+Capela",
      "filters": "With Trae Young and Dyson Daniels, without Clint Capela"
    },
    {
      "query": "player_name=Jalen+Johnson&teams_against%5B%5D=OPP_PTS&rank_filter%5B%5D=3%2C8",
      "filters": "Vs ranks 23–28 Points Allowed D"
    },
    {
      "query": "player_name=Jalen+Johnson&teams_against%5B%5D=OPP_PTS&rank_filter%5B%5D=4%2C4",
      "filters": "Vs rank 27 Points Allowed D"
    },
    {
      "query": "player_name=Jalen+Johnson&players_on%5B%5D=Trae+Young&players_on%5B%5D=Dyson+Daniels&players_on%5B%5D=Onyeka+Okongwu",
      "filters": "With Trae Young, Dyson Daniels and Onyeka Okongwu"
    },
    {
      "query": "player_name=Jalen+Johnson&teams_against%5B%5D=%3C10+Ft&rank_filter%5B%5D=5",
      "filters": "Vs top 5 <10 Ft D"
    }
  ],
